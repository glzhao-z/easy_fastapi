# 所有应用配置均使用 EASY_FASTAPI_ 前缀。
EASY_FASTAPI_APP_NAME=easy_fastapi
EASY_FASTAPI_APP_VERSION=0.1.0
EASY_FASTAPI_ENVIRONMENT=development
EASY_FASTAPI_DEBUG=false
EASY_FASTAPI_HOST=127.0.0.1
EASY_FASTAPI_PORT=8000
EASY_FASTAPI_LOG_LEVEL=INFO
EASY_FASTAPI_DOCS_ENABLED=true
EASY_FASTAPI_API_V1_PREFIX=/api/v1
EASY_FASTAPI_REQUEST_ID_HEADER=X-Request-ID

# 默认关闭，按需安装对应 extra 并启用。
EASY_FASTAPI_DATABASE_ENABLED=false
# EASY_FASTAPI_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/easy_fastapi
# EASY_FASTAPI_DATABASE_URL=mysql+asyncmy://root:mysql@localhost:3306/easy_fastapi
EASY_FASTAPI_DATABASE_POOL_SIZE=5
EASY_FASTAPI_DATABASE_MAX_OVERFLOW=10
EASY_FASTAPI_REDIS_ENABLED=false
# EASY_FASTAPI_REDIS_URL=redis://localhost:6379/0
EASY_FASTAPI_REDIS_KEY_PREFIX=easy_fastapi:
EASY_FASTAPI_DEPENDENCY_TIMEOUT=5
