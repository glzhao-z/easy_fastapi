# All application settings use the EASY_FASTAPI_ prefix.
EASY_FASTAPI_APP_NAME=easy_fastapi
EASY_FASTAPI_APP_VERSION=0.1.0
EASY_FASTAPI_ENVIRONMENT=development
EASY_FASTAPI_DEBUG=false
EASY_FASTAPI_HOST=127.0.0.1
EASY_FASTAPI_PORT=8000
EASY_FASTAPI_LOG_LEVEL=INFO
EASY_FASTAPI_DOCS_ENABLED=true
EASY_FASTAPI_API_V1_PREFIX=/api/v1
EASY_FASTAPI_REQUEST_ID_HEADER=X-Request-ID
